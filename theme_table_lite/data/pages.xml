<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data noupdate="0">

<!-- Pages de démonstration du thème. Dans un module theme_*, un <template>
     devient une theme.ir.ui.view et la page une theme.website.page : rien
     n'est créé dans le site avant l'application du thème. Le balisage est
     dupliqué depuis views/snippets/ pour que chaque section soit éditable
     dans l'oe_structure de la page. -->

    <template id="table_home" inherit_id="website.homepage" name="Accueil — Maison Lavaur">
        <xpath expr="//div[@id='wrap']" position="inside">
        <section class="o_table_hero o_table_hero_cover o_cc o_cc5"
                     style="background-image:url('/theme_table_lite/static/src/img/table_hero.png');">
                <div class="container">
                    <div class="o_table_hero_inner">
                        <span class="o_table_eyebrow">Cuisine de marché — Table de 24 couverts</span>
                        <h1 class="mb-3">Une carte courte, réécrite tous les jeudis</h1>
                        <p class="lead mb-0">Maison Lavaur cuisine ce que les producteurs de la vallée livrent le matin même. Six entrées, six plats, quatre desserts. Rien de plus, rien de figé.</p>
                        <div class="d-flex flex-wrap gap-3 mt-4"><a href="/reserver" class="btn btn-primary btn-lg">Réserver une table</a><a href="/la-carte" class="btn btn-outline-light btn-lg">Voir la carte</a></div>
                    </div>
                </div>
            </section>
        <section class="o_table_cards pt64 pb64 o_cc o_cc1">
                <div class="container">
                    <div class="text-center mx-auto mb-5" style="max-width:44rem">
                        <span class="o_table_eyebrow">Cette semaine</span>
                        <h2 class="mb-3">Ce qui sort de la cuisine en ce moment</h2>
                        <p class="lead mb-0">Trois assiettes reconduites tant que le produit tient. Le reste tourne.</p>
                    </div>
                    <div class="row g-4"><div class="col-lg-4 col-md-6">
                            <article class="o_table_card h-100">
                                <div class="o_table_card_media">
                                    <img src="/theme_table_lite/static/src/img/table_plat_1.png" alt=""/>
                                    <span class="o_table_pill">Entrée</span>
                                </div>
                                <div class="o_table_card_body">
                                    <h3 class="h4 mb-2">Courge rôtie, noisette, sarriette</h3>
                                    <p class="mb-3">Une courge de plein champ passée deux heures au four doux, noisettes torréfiées le matin, crème de sarriette.</p>
                                    <p class="o_table_meta mb-0">Végétarien · 12 €</p>
                                </div>
                            </article>
                        </div><div class="col-lg-4 col-md-6">
                            <article class="o_table_card h-100">
                                <div class="o_table_card_media">
                                    <img src="/theme_table_lite/static/src/img/table_plat_2.png" alt=""/>
                                    <span class="o_table_pill">Plat</span>
                                </div>
                                <div class="o_table_card_body">
                                    <h3 class="h4 mb-2">Épaule d'agneau confite, haricots coco</h3>
                                    <p class="mb-3">Sept heures à basse température, jus court monté au thym. Les cocos viennent de la ferme du Mailhac.</p>
                                    <p class="o_table_meta mb-0">Servi à partager · 26 €</p>
                                </div>
                            </article>
                        </div><div class="col-lg-4 col-md-6">
                            <article class="o_table_card h-100">
                                <div class="o_table_card_media">
                                    <img src="/theme_table_lite/static/src/img/table_plat_3.png" alt=""/>
                                    <span class="o_table_pill">Dessert</span>
                                </div>
                                <div class="o_table_card_body">
                                    <h3 class="h4 mb-2">Tarte fine aux pommes de garde</h3>
                                    <p class="mb-3">Pâte feuilletée maison tournée la veille, pommes du verger haut, caramel au beurre demi-sel.</p>
                                    <p class="o_table_meta mb-0">Pour deux · 11 €</p>
                                </div>
                            </article>
                        </div></div>
                </div>
            </section>
        <section class="o_table_split pt64 pb64 o_cc o_cc1">
                <div class="container">
                    <div class="row align-items-center g-5"><div class="col-lg-6 order-lg-2">
                            <span class="o_table_eyebrow">La maison</span>
                            <h2 class="mb-3">Vingt-quatre couverts, une seule salle, aucun deuxième service</h2>
                            <p>Nous avons choisi de ne pas remplir deux fois la salle. Vous gardez votre table toute la soirée, la cuisine garde son rythme, et personne ne vous demande de partir.</p>
                            <ul class="o_table_points list-unstyled mt-4 mb-0"><li><i class="fa fa-angle-right me-2"/>Une seule salle, sans étage ni annexe</li><li><i class="fa fa-angle-right me-2"/>Pas de deuxième service le soir</li><li><i class="fa fa-angle-right me-2"/>Cuisine ouverte à vue sur la salle</li><li><i class="fa fa-angle-right me-2"/>Menu enfant préparé à la commande</li></ul>
                            <div class="d-flex flex-wrap gap-3 mt-4"><a href="/le-lieu" class="btn btn-primary btn-lg">Découvrir le lieu</a></div>
                        </div><div class="col-lg-6 order-lg-1">
                            <div class="o_table_split_media"><img src="/theme_table_lite/static/src/img/table_salle.png" alt="" class="img-fluid"/></div>
                        </div></div>
                </div>
            </section>
        <section class="o_table_cta pt64 pb64 o_cc o_cc5" style="background-image:url('/theme_table_lite/static/src/img/table_cta.png');">
                <div class="container">
                    <div class="o_table_cta_inner text-center mx-auto" style="max-width:46rem">
                        <span class="o_table_eyebrow">Réservation</span>
                        <h2 class="mb-3">Le service du soir part vite en fin de semaine</h2>
                        <p class="lead mb-0">Nous ouvrons les réservations quinze jours à l'avance. Au-delà de six personnes, écrivez-nous : nous adaptons la carte et le rythme du service.</p>
                        <div class="d-flex flex-wrap gap-3 justify-content-center mt-4">
                            <a href="/reserver" class="btn btn-primary btn-lg">Réserver en ligne</a><a href="/contactus" class="btn btn-outline-light btn-lg">Nous écrire</a>
                        </div>
                    </div>
                </div>
            </section>
        </xpath>
    </template>

</data>
</odoo>
