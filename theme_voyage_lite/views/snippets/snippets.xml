<?xml version="1.0" encoding="utf-8"?>
<odoo>

<template id="voyage_snippets" inherit_id="website.snippets" name="Blocs Voyage">
    <xpath expr="//t[@id='installed_snippets_hook']" position="before">
        <t snippet-group="voyage" t-snippet="website.s_snippet_group" string="Voyage"
           t-thumbnail="/theme_voyage_lite/static/src/img/snippets_thumbs/voyage_group.png"/>
    </xpath>
    <xpath expr="//snippets[@id='snippet_structure']" position="inside">
        <t t-snippet="theme_voyage_lite.s_voyage_hero" string="Bandeau d'accueil" group="voyage"
           t-thumbnail="/theme_voyage_lite/static/src/img/snippets_thumbs/s_voyage_hero.png">
            <keywords>bandeau, hero, accueil, couverture, plein ecran, voyage</keywords>
        </t>
        <t t-snippet="theme_voyage_lite.s_voyage_destinations" string="Grille de destinations" group="voyage"
           t-thumbnail="/theme_voyage_lite/static/src/img/snippets_thumbs/s_voyage_destinations.png">
            <keywords>destinations, cartes, grille, sejours, catalogue</keywords>
        </t>
        <t t-snippet="theme_voyage_lite.s_voyage_recit" string="Récit deux colonnes" group="voyage"
           t-thumbnail="/theme_voyage_lite/static/src/img/snippets_thumbs/s_voyage_recit.png">
            <keywords>recit, carnet, texte image, deux colonnes, histoire</keywords>
        </t>
        <t t-snippet="theme_voyage_lite.s_voyage_appel" string="Appel à l'action" group="voyage"
           t-thumbnail="/theme_voyage_lite/static/src/img/snippets_thumbs/s_voyage_appel.png">
            <keywords>appel, action, cta, devis, contact, conversion</keywords>
        </t>
    </xpath>
</template>

</odoo>
