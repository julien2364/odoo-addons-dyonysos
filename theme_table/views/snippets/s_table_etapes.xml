<?xml version="1.0" encoding="utf-8"?>
<odoo>

<template id="s_table_etapes" name="Parcours de réservation">
    <section class="o_table_steps pt64 pb64 o_cc o_cc1">
            <div class="container">
                <div class="text-center mx-auto mb-5" style="max-width:44rem">
                    <span class="o_table_eyebrow">Comment ça se passe</span>
                    <h2 class="mb-3">De la réservation à l'addition</h2>
                
                </div>
                <div class="row g-4 o_table_steps_row"><div class="col-lg-3 col-md-6">
                        <div class="o_table_step h-100">
                            <span class="o_table_step_num">01</span>
                            <h3 class="h5 mb-2">Vous réservez</h3>
                            <p class="mb-0">En ligne jusqu'à 18h le jour même, par téléphone au-delà.</p>
                        </div>
                    </div><div class="col-lg-3 col-md-6">
                        <div class="o_table_step h-100">
                            <span class="o_table_step_num">02</span>
                            <h3 class="h5 mb-2">On vous confirme</h3>
                            <p class="mb-0">Un message la veille, avec le plan d'accès et les places de stationnement.</p>
                        </div>
                    </div><div class="col-lg-3 col-md-6">
                        <div class="o_table_step h-100">
                            <span class="o_table_step_num">03</span>
                            <h3 class="h5 mb-2">Vous gardez la table</h3>
                            <p class="mb-0">Aucun deuxième service : la salle est à vous jusqu'à la fermeture.</p>
                        </div>
                    </div><div class="col-lg-3 col-md-6">
                        <div class="o_table_step h-100">
                            <span class="o_table_step_num">04</span>
                            <h3 class="h5 mb-2">On garde la trace</h3>
                            <p class="mb-0">Vos allergies et préférences sont notées pour la fois suivante.</p>
                        </div>
                    </div></div>
            </div>
        </section>
</template>

</odoo>
