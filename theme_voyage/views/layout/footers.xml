<?xml version="1.0" encoding="utf-8"?>
<odoo>

<!-- =====================================================================
     Deux dispositions de pied de page, proposées dans le panneau
     « Pied de page » de l'éditeur de site.
     ===================================================================== -->

<!-- Variante 1 — Pied de page étendu -->
<template id="template_footer_voyage_expanded" inherit_id="website.layout"
          name="Voyage — Pied de page étendu" active="False">
    <xpath expr="//div[@id='footer']" position="replace">
        <div id="footer" class="oe_structure oe_structure_solo text-break o_voyage_footer_expanded"
             t-ignore="true" t-if="not no_footer">
            <section class="s_text_block pt64 pb32" data-snippet="s_text_block" data-name="Container">
                <div class="container">
                    <div class="row g-5">
                        <div class="col-lg-4">
                            <h5 class="mb-3">L'agence</h5>
                            <p class="mb-3">Des itinéraires lents, à pied, à vélo et en train, conçus étape par étape.</p>
                            <p class="mb-0"><a href="/contactus">Nous écrire</a></p>
                        </div>
                        <div class="col-6 col-lg-2">
                            <h6>Voyager</h6>
                            <ul class="list-unstyled mb-0">
                                    <li><a href="/nos-voyages">Tous les voyages</a></li>
                                    <li><a href="/destination-vantour">Destinations</a></li>
                                    <li><a href="/itineraire-cretes-de-vantour">Itinéraires</a></li>
                                    <li><a href="/contactus">Sur mesure</a></li>
                            </ul>
                        </div>
                        <div class="col-6 col-lg-2">
                            <h6>L'agence</h6>
                            <ul class="list-unstyled mb-0">
                                    <li><a href="/contactus">Nous contacter</a></li>
                                    <li><a href="/nos-voyages">Nos engagements</a></li>
                                    <li><a href="/itineraire-cretes-de-vantour">Carnets de bord</a></li>
                                    <li><a href="/contactus">Devis</a></li>
                            </ul>
                        </div>
                        <div class="col-lg-4">
                            <h6>Préparer son départ</h6>
                            <p class="mb-3">Dites-nous en trois lignes ce que vous cherchez : période, niveau, durée.</p>
                            <p class="mb-0"><a href="/contactus" class="btn btn-primary">Demander un devis</a></p>
                        </div>
                    </div>
                </div>
            </section>
        </div>
    </xpath>
</template>

<!-- Variante 2 — Pied de page compact -->
<template id="template_footer_voyage_compact" inherit_id="website.layout"
          name="Voyage — Pied de page compact" active="False">
    <xpath expr="//div[@id='footer']" position="replace">
        <div id="footer" class="oe_structure oe_structure_solo text-break o_voyage_footer_compact"
             t-ignore="true" t-if="not no_footer">
            <section class="s_text_block pt32 pb32" data-snippet="s_text_block" data-name="Container">
                <div class="container">
                    <div class="row align-items-center g-3">
                        <div class="col-lg-5">
                            <p class="mb-0">Des itinéraires lents, à pied, à vélo et en train, conçus étape par étape.</p>
                        </div>
                        <div class="col-lg-7 text-lg-end">
                            <ul class="list-inline mb-0">
                                <li class="list-inline-item"><a href="/nos-voyages">Voyages</a></li>
                                <li class="list-inline-item"><a href="/destination-vantour">Destinations</a></li>
                                <li class="list-inline-item"><a href="/itineraire-cretes-de-vantour">Itinéraires</a></li>
                                <li class="list-inline-item"><a href="/contactus">Devis</a></li>
                            </ul>
                        </div>
                    </div>
                </div>
            </section>
        </div>
    </xpath>
</template>

</odoo>
