<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_amazon_account_list" model="ir.ui.view">
        <field name="name">amazon.account.community.list</field>
        <field name="model">amazon.account.community</field>
        <field name="arch" type="xml">
            <list string="Comptes Amazon">
                <field name="name"/>
                <field name="seller_id"/>
                <field name="region"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="last_order_sync"/>
                <field name="last_stock_sync"/>
            </list>
        </field>
    </record>

    <record id="view_amazon_account_form" model="ir.ui.view">
        <field name="name">amazon.account.community.form</field>
        <field name="model">amazon.account.community</field>
        <field name="arch" type="xml">
            <form string="Compte Amazon">
                <header>
                    <button name="action_test_connection" type="object" string="Tester la connexion"
                            class="btn-secondary"/>
                    <button name="action_import_orders" type="object" string="Importer les commandes"
                            class="btn-primary"/>
                    <button name="action_push_offers" type="object" string="Envoyer stock et prix"
                            class="btn-secondary"/>
                    <button name="action_push_tracking" type="object" string="Envoyer le suivi"
                            class="btn-secondary"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_orders" type="object" class="oe_stat_button" icon="fa-shopping-cart">
                            <field name="order_count" widget="statinfo" string="Commandes"/>
                        </button>
                        <button name="action_view_logs" type="object" class="oe_stat_button" icon="fa-list">
                            <field name="log_count" widget="statinfo" string="Journaux"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archivé" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Boutique Amazon Europe"/></h1>
                    </div>
                    <group>
                        <group string="Identifiants SP-API">
                            <field name="seller_id"/>
                            <field name="lwa_client_id" password="True" groups="base.group_system"/>
                            <field name="lwa_client_secret" password="True" groups="base.group_system"/>
                            <field name="lwa_refresh_token" password="True" groups="base.group_system"/>
                            <field name="region"/>
                            <field name="endpoint_url"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group string="Paramétrage Odoo">
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="journal_id"/>
                            <field name="team_id"/>
                            <field name="warehouse_id"/>
                            <field name="pricelist_id"/>
                            <field name="shipping_product_id"/>
                            <field name="fiscal_position_id"/>
                        </group>
                    </group>
                    <group>
                        <group string="Import">
                            <field name="auto_confirm_orders"/>
                            <field name="import_days"/>
                        </group>
                        <group string="Dernières synchronisations">
                            <field name="last_order_sync"/>
                            <field name="last_stock_sync"/>
                            <field name="last_price_sync"/>
                            <field name="last_tracking_sync"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Places de marché" name="marketplaces">
                            <field name="marketplace_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="country_code"/>
                                    <field name="marketplace_id"/>
                                    <field name="currency_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_amazon_account_search" model="ir.ui.view">
        <field name="name">amazon.account.community.search</field>
        <field name="model">amazon.account.community</field>
        <field name="arch" type="xml">
            <search string="Comptes Amazon">
                <field name="name"/>
                <field name="seller_id"/>
                <filter name="filter_inactive" string="Archivés" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_region" string="Région" context="{'group_by': 'region'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_amazon_account" model="ir.actions.act_window">
        <field name="name">Comptes Amazon</field>
        <field name="res_model">amazon.account.community</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Créez votre premier compte vendeur Amazon</p>
            <p>Renseignez le Seller ID et les identifiants de votre application LWA (SP-API),
               choisissez vos places de marché, puis testez la connexion.</p>
        </field>
    </record>
</odoo>
