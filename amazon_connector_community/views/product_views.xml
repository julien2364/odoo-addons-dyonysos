<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_template_form_amazon" model="ir.ui.view">
        <field name="name">product.template.form.amazon</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='group_general']" position="inside">
                <field name="amazon_sync" groups="amazon_connector_community.group_amazon_user"/>
            </xpath>
        </field>
    </record>

    <record id="view_product_product_form_amazon" model="ir.ui.view">
        <field name="name">product.product.form.amazon</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='default_code']" position="after">
                <field name="amazon_sync" groups="amazon_connector_community.group_amazon_user"/>
                <field name="amazon_sku" groups="amazon_connector_community.group_amazon_user"/>
            </xpath>
        </field>
    </record>
</odoo>
