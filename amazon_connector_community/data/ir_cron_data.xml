<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_amazon_import_orders" model="ir.cron">
            <field name="name">Amazon Connector : import des commandes</field>
            <field name="model_id" ref="model_amazon_account_community"/>
            <field name="state">code</field>
            <field name="code">model._cron_import_orders()</field>
            <field name="interval_number">10</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="False"/>
        </record>

        <record id="ir_cron_amazon_push_offers" model="ir.cron">
            <field name="name">Amazon Connector : envoi du stock et des prix</field>
            <field name="model_id" ref="model_amazon_account_community"/>
            <field name="state">code</field>
            <field name="code">model._cron_push_offers()</field>
            <field name="interval_number">15</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="False"/>
        </record>

        <record id="ir_cron_amazon_push_tracking" model="ir.cron">
            <field name="name">Amazon Connector : remontée du suivi</field>
            <field name="model_id" ref="model_amazon_account_community"/>
            <field name="state">code</field>
            <field name="code">model._cron_push_tracking()</field>
            <field name="interval_number">30</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="False"/>
        </record>
    </data>
</odoo>
