<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_mcp" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.mcp</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='integration']" position="inside">
                <setting id="mcp_enabled_setting" string="MCP Server (AI assistants)" company_dependent="0"
                         help="Expose this database to AI assistants through the Model Context Protocol, at /mcp.">
                    <field name="mcp_enabled"/>
                    <div class="content-group" invisible="not mcp_enabled">
                        <div class="row mt8">
                            <field name="mcp_allow_writes" class="col-lg-1"/>
                            <label for="mcp_allow_writes" class="col-lg-10"/>
                        </div>
                        <div class="row">
                            <field name="mcp_log_arguments" class="col-lg-1"/>
                            <label for="mcp_log_arguments" class="col-lg-10"/>
                        </div>
                        <div class="row">
                            <label for="mcp_log_retention_days" class="col-lg-5 o_light_label"/>
                            <field name="mcp_log_retention_days"/>
                        </div>
                        <div class="row">
                            <label for="mcp_rate_limit" class="col-lg-5 o_light_label"/>
                            <field name="mcp_rate_limit"/>
                        </div>
                        <div class="mt8">
                            <button name="action_mcp_open_models" type="object" string="Configure exposed models"
                                    class="btn-link" icon="fa-arrow-right"/>
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
