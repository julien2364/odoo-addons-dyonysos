<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mcp_access_log_view_list" model="ir.ui.view">
        <field name="name">mcp.access.log.list</field>
        <field name="model">mcp.access.log</field>
        <field name="arch" type="xml">
            <list create="false" default_order="create_date desc">
                <field name="create_date" string="When"/>
                <field name="user_id"/>
                <field name="client_name"/>
                <field name="tool"/>
                <field name="model_name"/>
                <field name="method" optional="hide"/>
                <field name="record_count" sum="Records"/>
                <field name="duration" sum="Total ms" optional="show"/>
                <field name="ip" optional="hide"/>
                <field name="state" widget="badge" decoration-success="state == 'done'"
                       decoration-danger="state in ('error', 'denied')"/>
            </list>
        </field>
    </record>

    <record id="mcp_access_log_view_form" model="ir.ui.view">
        <field name="name">mcp.access.log.form</field>
        <field name="model">mcp.access.log</field>
        <field name="arch" type="xml">
            <form create="false" edit="false">
                <sheet>
                    <group>
                        <group>
                            <field name="create_date"/>
                            <field name="user_id"/>
                            <field name="client_name"/>
                            <field name="ip"/>
                        </group>
                        <group>
                            <field name="tool"/>
                            <field name="model_name"/>
                            <field name="method"/>
                            <field name="record_count"/>
                            <field name="record_ids"/>
                            <field name="duration"/>
                            <field name="state"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Arguments" name="arguments"><field name="arguments"/></page>
                        <page string="Error" name="error" invisible="state == 'done'"><field name="error"/></page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="mcp_access_log_view_search" model="ir.ui.view">
        <field name="name">mcp.access.log.search</field>
        <field name="model">mcp.access.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="user_id"/>
                <field name="tool"/>
                <field name="model_name"/>
                <field name="client_name"/>
                <filter name="errors" string="Errors and denials" domain="[('state', '!=', 'done')]"/>
                <filter name="today" string="Today" domain="[('create_date', '>=', context_today().strftime('%Y-%m-%d'))]"/>
                <group>
                    <filter name="group_user" string="User" context="{'group_by': 'user_id'}"/>
                    <filter name="group_tool" string="Tool" context="{'group_by': 'tool'}"/>
                    <filter name="group_model" string="Model" context="{'group_by': 'model_name'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="mcp_access_log_action" model="ir.actions.act_window">
        <field name="name">Access log</field>
        <field name="res_model">mcp.access.log</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_tool': 1}</field>
    </record>
</odoo>
