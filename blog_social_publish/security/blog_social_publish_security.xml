<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_groups_privilege_blog_social" model="res.groups.privilege">
        <field name="name">Blog Social</field>
        <field name="sequence">80</field>
        <field name="category_id" ref="base.module_category_website"/>
    </record>

    <record id="group_blog_social_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_blog_social"/>
        <field name="implied_ids" eval="[(4, ref('website.group_website_designer'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
    </record>

    <record id="blog_social_channel_company_rule" model="ir.rule">
        <field name="name">Blog social channel: multi-company</field>
        <field name="model_id" ref="model_blog_social_channel"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>

    <record id="blog_social_post_company_rule" model="ir.rule">
        <field name="name">Blog social post: multi-company</field>
        <field name="model_id" ref="model_blog_social_post"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>
</odoo>
