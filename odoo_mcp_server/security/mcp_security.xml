<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_mcp" model="ir.module.category">
        <field name="name">MCP Server</field>
        <field name="description">Access to the AI assistant connector configuration.</field>
        <field name="sequence">30</field>
    </record>

    <record id="privilege_mcp" model="res.groups.privilege">
        <field name="name">MCP Server</field>
        <field name="category_id" ref="module_category_mcp"/>
        <field name="sequence">30</field>
    </record>

    <record id="group_mcp_user" model="res.groups">
        <field name="name">MCP User</field>
        <field name="privilege_id" ref="privilege_mcp"/>
        <field name="comment">Can create MCP API keys for itself and read its own access log.</field>
    </record>

    <record id="group_mcp_manager" model="res.groups">
        <field name="name">MCP Administrator</field>
        <field name="privilege_id" ref="privilege_mcp"/>
        <field name="implied_ids" eval="[(4, ref('group_mcp_user'))]"/>
        <field name="comment">Configures which models are exposed to AI assistants and reads the whole audit log.</field>
    </record>

    <record id="base.user_admin" model="res.users">
        <field name="group_ids" eval="[(4, ref('group_mcp_manager'))]"/>
    </record>

    <record id="mcp_access_log_rule_own" model="ir.rule">
        <field name="name">MCP log: own entries only</field>
        <field name="model_id" ref="model_mcp_access_log"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_mcp_user'))]"/>
    </record>

    <record id="mcp_access_log_rule_all" model="ir.rule">
        <field name="name">MCP log: all entries for administrators</field>
        <field name="model_id" ref="model_mcp_access_log"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_mcp_manager'))]"/>
    </record>
</odoo>
