<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_ai_extract" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.ai.document.extract</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='account_vendor_bills']" position="after">
                <block title="AI Digitization" id="ai_document_extract_block" help="Turn PDF and image receipts into draft vendor bills and expenses with an AI vision model.">
                    <setting id="ai_extract_provider_setting" string="AI provider" help="Anthropic reads PDF files natively. OpenAI-compatible endpoints receive images, or the text layer of PDFs.">
                        <div class="content-group">
                            <div class="row mt8">
                                <label for="ai_extract_provider" class="col-lg-4 o_light_label"/>
                                <field name="ai_extract_provider"/>
                            </div>
                            <div class="row">
                                <label for="ai_extract_api_key" class="col-lg-4 o_light_label"/>
                                <field name="ai_extract_api_key" password="True"/>
                            </div>
                            <div class="row">
                                <label for="ai_extract_model" class="col-lg-4 o_light_label"/>
                                <field name="ai_extract_model" placeholder="provider default"/>
                            </div>
                            <div class="row">
                                <label for="ai_extract_base_url" class="col-lg-4 o_light_label"/>
                                <field name="ai_extract_base_url" placeholder="provider default"/>
                            </div>
                        </div>
                    </setting>
                    <setting id="ai_extract_auto_setting" string="Automatic digitization" help="Uncheck to only digitize when clicking the 'AI Extract' button.">
                        <div class="content-group">
                            <div class="row mt8">
                                <field name="ai_extract_auto_invoices" class="col-lg-1"/>
                                <label for="ai_extract_auto_invoices" class="col-lg-10"/>
                            </div>
                            <div class="row">
                                <field name="ai_extract_auto_expenses" class="col-lg-1"/>
                                <label for="ai_extract_auto_expenses" class="col-lg-10"/>
                            </div>
                            <div class="row">
                                <field name="ai_extract_create_partner" class="col-lg-1"/>
                                <label for="ai_extract_create_partner" class="col-lg-10"/>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
