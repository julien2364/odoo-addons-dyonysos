    <template id="cadre_agence_p" name="L'agence">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure oe_empty">
            <section class="o_cadre_split pt64 pb64 o_cc o_cc1">
                    <div class="container">
                        <div class="row align-items-center g-5"><div class="col-lg-6 order-lg-2">
                                <span class="o_cadre_eyebrow">Depuis 2011</span>
                                <h2 class="mb-3">Une agence indépendante, sans réseau ni redevance de franchise</h2>
                                <p>Nous ne reversons pas 6 % de nos honoraires à une tête de réseau, ce qui nous permet d'afficher un barème plus bas que la moyenne du secteur sans réduire le service.</p>
                                <ul class="o_cadre_points list-unstyled mt-4 mb-0"><li><i class="fa fa-angle-right me-2"/>Aucune redevance de franchise</li><li><i class="fa fa-angle-right me-2"/>Aucun apporteur d'affaires rémunéré</li><li><i class="fa fa-angle-right me-2"/>Comptabilité et gestion locative internes</li><li><i class="fa fa-angle-right me-2"/>Barème public depuis l'ouverture</li></ul>
                                <div class="d-flex flex-wrap gap-3 mt-4"><a href="/honoraires" class="btn btn-primary btn-lg">Voir nos honoraires</a></div>
                            </div><div class="col-lg-6 order-lg-1">
                                <div class="o_cadre_split_media"><img src="/theme_cadre/static/src/img/cadre_agence.png" alt="" class="img-fluid"/></div>
                            </div></div>
                    </div>
                </section>
            <section class="o_cadre_team pt64 pb64 o_cc o_cc1">
                    <div class="container">
                        <div class="text-center mx-auto mb-5" style="max-width:44rem">
                            <span class="o_cadre_eyebrow">L'agence</span>
                            <h2 class="mb-3">Quatre personnes, aucun apporteur d'affaires</h2>
                
                        </div>
                        <div class="row g-4"><div class="col-lg-3 col-6">
                                <div class="o_cadre_member text-center">
                                    <img src="/theme_cadre/static/src/img/cadre_eq_1.png" alt="" class="o_cadre_member_photo"/>
                                    <h3 class="h5 mt-3 mb-1">Claire Bastide</h3>
                                    <p class="o_cadre_meta mb-0">Gérante, transaction</p>
                                </div>
                            </div><div class="col-lg-3 col-6">
                                <div class="o_cadre_member text-center">
                                    <img src="/theme_cadre/static/src/img/cadre_eq_2.png" alt="" class="o_cadre_member_photo"/>
                                    <h3 class="h5 mt-3 mb-1">Thomas Rive</h3>
                                    <p class="o_cadre_meta mb-0">Gérant, gestion locative</p>
                                </div>
                            </div><div class="col-lg-3 col-6">
                                <div class="o_cadre_member text-center">
                                    <img src="/theme_cadre/static/src/img/cadre_eq_3.png" alt="" class="o_cadre_member_photo"/>
                                    <h3 class="h5 mt-3 mb-1">Amélie Coulon</h3>
                                    <p class="o_cadre_meta mb-0">Négociatrice</p>
                                </div>
                            </div><div class="col-lg-3 col-6">
                                <div class="o_cadre_member text-center">
                                    <img src="/theme_cadre/static/src/img/cadre_eq_4.png" alt="" class="o_cadre_member_photo"/>
                                    <h3 class="h5 mt-3 mb-1">Bruno Lestrade</h3>
                                    <p class="o_cadre_meta mb-0">Chargé de dossiers</p>
                                </div>
                            </div></div>
                    </div>
                </section>
            <section class="o_cadre_testimonials pt64 pb64 o_cc o_cc2">
                    <div class="container">
                        <div class="text-center mx-auto mb-5" style="max-width:44rem">
                            <span class="o_cadre_eyebrow">Retours</span>
                            <h2 class="mb-3">Trois vendeurs, trois dossiers bouclés en 2025</h2>
                
                        </div>
                        <div class="row g-4"><div class="col-lg-4 col-md-6">
                                <figure class="o_cadre_quote h-100">
