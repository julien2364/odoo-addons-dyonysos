<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="packlink_account_company_rule" model="ir.rule">
        <field name="name">Compte Packlink : multi-société</field>
        <field name="model_id" ref="model_packlink_account"/>
        <field name="domain_force">[('company_id','in',company_ids)]</field>
        <field name="global" eval="True"/>
    </record>
    <record id="packlink_log_company_rule" model="ir.rule">
        <field name="name">Journal Packlink : multi-société</field>
        <field name="model_id" ref="model_packlink_log"/>
        <field name="domain_force">['|',('company_id','=',False),('company_id','in',company_ids)]</field>
        <field name="global" eval="True"/>
    </record>
</odoo>
