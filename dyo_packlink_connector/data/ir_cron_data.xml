<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_cron_packlink_tracking" model="ir.cron">
        <field name="name">Packlink : rafraîchir le suivi des expéditions</field>
        <field name="model_id" ref="stock.model_stock_picking"/>
        <field name="state">code</field>
        <field name="code">model._cron_packlink_refresh_tracking()</field>
        <field name="interval_number">6</field>
        <field name="interval_type">hours</field>
        <field name="active" eval="False"/>
    </record>
    <record id="ir_cron_packlink_log_purge" model="ir.cron">
        <field name="name">Packlink : purge du journal</field>
        <field name="model_id" ref="model_packlink_log"/>
        <field name="state">code</field>
        <field name="code">model._cron_purge()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">weeks</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
