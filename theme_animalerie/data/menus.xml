<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data noupdate="0">

    <!-- Entrées de menu du thème. Comme les pages, ce sont des objets de
         thème : elles ne sont créées dans le site qu'à l'application. -->

    <record id="anim_menu_categorie" model="theme.website.menu">
        <field name="name">Chiens</field>
        <field name="url">/categorie-chiens</field>
        <field name="page_id" ref="page_categorie_website_page"/>
        <field name="sequence">22</field>
        <field name="use_main_menu_as_parent" eval="True"/>
    </record>

</data>
</odoo>
