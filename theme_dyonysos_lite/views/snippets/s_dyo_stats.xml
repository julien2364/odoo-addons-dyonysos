        <div class="container">
            <div class="row g-4 text-center">
                <div class="col-6 col-lg-3">
                    <p class="mb-0">
                        <span class="o_dyo_stat_value">120+</span>
                        <span class="o_dyo_stat_label">projets livrés</span>
