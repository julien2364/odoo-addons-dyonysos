#. module: theme_presse_lite
#: model_terms:blog.post,content:theme_presse_lite.post_presse_07
msgid ""
"Dans les faits, un tiers des tonnages transite par un second site, faute de "
"capacité de stockage. Ce détour ajoute quarante kilomètres et un "
"transbordement."
msgstr ""
"Dans les faits, un tiers des tonnages transite par un second site, faute de "
"capacité de stockage. Ce détour ajoute quarante kilomètres et un "
"transbordement."

#. module: theme_presse_lite
#: model:blog.post,subtitle:theme_presse_lite.post_presse_11
msgid ""
"Deux cents pièces collectées auprès des habitants, sans aucune commande "
"publique."
msgstr ""
"Deux cents pièces collectées auprès des habitants, sans aucune commande "
"publique."

#. module: theme_presse_lite
#: model_terms:blog.post,content:theme_presse_lite.post_presse_10
msgid ""
"Elles partagent en revanche le même modèle immobilier : des baux courts "
"négociés dans des locaux vacants, avec une clause de sortie à dix-huit mois."
msgstr ""
"Elles partagent en revanche le même modèle immobilier : des baux courts "
"négociés dans des locaux vacants, avec une clause de sortie à dix-huit mois."

#. module: theme_presse_lite
#: model:blog.post,name:theme_presse_lite.post_presse_07
#: model_terms:theme.ir.ui.view,arch:theme_presse_lite.s_presse_a_lire_aussi
msgid "Enquête : où part vraiment le verre trié dans l'agglomération"
msgstr "Enquête : où part vraiment le verre trié dans l'agglomération"

#. module: theme_presse_lite
#: model:blog.blog,subtitle:theme_presse_lite.blog_economie
