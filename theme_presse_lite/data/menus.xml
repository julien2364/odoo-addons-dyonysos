<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data noupdate="0">

    <!-- Entrées de menu du thème. Comme les pages, ce sont des objets de
         thème : elles ne sont créées dans le site qu'à l'application. -->

    <record id="presse_menu_magazine" model="theme.website.menu">
        <field name="name">Magazine</field>
        <field name="url">/magazine</field>
        <field name="page_id" ref="page_magazine_website_page"/>
        <field name="sequence">20</field>
        <field name="use_main_menu_as_parent" eval="True"/>
    </record>

</data>
</odoo>
