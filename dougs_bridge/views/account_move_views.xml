<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_dougs" model="ir.ui.view">
        <field name="name">account.move.form.inherit.dougs.bridge</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_send_to_dougs" type="object" string="Send to accountant" class="btn-secondary"
                        invisible="state != 'posted' or move_type not in ('out_invoice', 'out_refund', 'in_invoice', 'in_refund') or dougs_state == 'sent'"/>
            </xpath>
            <xpath expr="//field[@name='ref']" position="after">
                <field name="dougs_state" invisible="dougs_state == 'none'"/>
            </xpath>
        </field>
    </record>

    <record id="view_invoice_tree_dougs" model="ir.ui.view">
        <field name="name">account.move.list.inherit.dougs.bridge</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_invoice_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='amount_total_in_currency_signed']" position="after">
                <field name="dougs_state" optional="hide"/>
            </xpath>
        </field>
    </record>

    <record id="action_send_to_dougs_server" model="ir.actions.server">
        <field name="name">Send to accountant (Dougs Bridge)</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = records.action_send_to_dougs()</field>
    </record>
</odoo>
