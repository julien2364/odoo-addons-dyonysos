<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="dougs_export_batch_company_rule" model="ir.rule">
        <field name="name">Dougs export batch: multi-company</field>
        <field name="model_id" ref="model_dougs_export_batch"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>

    <record id="dougs_export_line_company_rule" model="ir.rule">
        <field name="name">Dougs export line: multi-company</field>
        <field name="model_id" ref="model_dougs_export_line"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>
</odoo>
