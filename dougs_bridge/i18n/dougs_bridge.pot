#. module: dougs_bridge
#: model:mail.template,body_html:dougs_bridge.mail_template_dougs_send
msgid ""
"<div style=\"font-family: Arial, sans-serif; font-size: 13px;\">\n"
"    <p>Bonjour,</p>\n"
"    <p>Veuillez trouver ci-joint le lot <b t-out=\"object.name\"/> de pièces comptables de <t t-out=\"object.company_id.name\"/> :\n"
"       <t t-out=\"object.count_out\"/> facture(s) client, <t t-out=\"object.count_in\"/> facture(s) fournisseur,\n"
"       <t t-out=\"object.count_expense\"/> note(s) de frais. Le fichier <i>journal.csv</i> récapitule chaque pièce.</p>\n"
"    <p>Cordialement,<br/><t t-out=\"object.company_id.name\"/></p>\n"
"</div>\n"
"        "
msgstr ""

#. module: dougs_bridge
#: model:mail.template,body_html:dougs_bridge.mail_template_dougs_batch
msgid ""
"<div style=\"font-family: Arial, sans-serif; font-size: 13px;\">\n"
"    <p>Lot <b t-out=\"object.name\"/> — canal <b t-out=\"object.transport\"/> — état <b t-out=\"object.state\"/>.</p>\n"
"    <p>\n"
"        Factures clients : <t t-out=\"object.count_out\"/> ·\n"
"        Factures fournisseurs : <t t-out=\"object.count_in\"/> ·\n"
"        Notes de frais : <t t-out=\"object.count_expense\"/> ·\n"
"        Erreurs : <t t-out=\"object.count_error\"/>\n"
"    </p>\n"
"    <t t-if=\"object.log\">\n"
"        <pre style=\"background:#f5f5f5;padding:8px;white-space:pre-wrap;\" t-out=\"object.log\"/>\n"
"    </t>\n"
"    <p style=\"color:#888;\">Généré automatiquement par Dougs Bridge (DYONYSOS).</p>\n"
"</div>\n"
"        "
msgstr ""

