<?xml version="1.0" encoding="utf-8"?>
<odoo>

<!-- =====================================================================
     Variante 1 — Pied de page étendu : quatre colonnes.
     ===================================================================== -->
<template id="template_footer_dyo_expanded" inherit_id="website.layout"
          name="Agence B2B — Pied de page étendu" active="False">
    <xpath expr="//div[@id='footer']" position="replace">
        <div id="footer" class="oe_structure oe_structure_solo text-break o_dyo_footer_expanded"
             t-ignore="true" t-if="not no_footer">
            <section class="s_text_block pt64 pb32" data-snippet="s_text_block" data-name="Container">
                <div class="container">
                    <div class="row g-5">
                        <div class="col-lg-4">
                            <h5 class="mb-3">L'agence</h5>
                            <p class="mb-3">
                                Conception, refonte et exploitation de plateformes métier
                                pour les directions techniques.
                            </p>
                            <p class="mb-0">
                                12 rue des Ateliers, 75011 Paris<br/>
                                <a href="/contact">Nous écrire</a>
                            </p>
                        </div>
                        <div class="col-6 col-lg-2">
                            <h6>Services</h6>
                            <ul class="list-unstyled mb-0">
                                <li><a href="/services">Cadrage</a></li>
                                <li><a href="/services">Réalisation</a></li>
                                <li><a href="/services">Exploitation</a></li>
                                <li><a href="/tarifs">Tarifs</a></li>
                            </ul>
                        </div>
                        <div class="col-6 col-lg-2">
                            <h6>Agence</h6>
                            <ul class="list-unstyled mb-0">
                                <li><a href="/a-propos">À propos</a></li>
                                <li><a href="/portfolio">Réalisations</a></li>
                                <li><a href="/journal">Journal</a></li>
                                <li><a href="/contact">Contact</a></li>
                            </ul>
                        </div>
                        <div class="col-lg-4">
                            <h6>Rester informé</h6>
                            <p class="mb-3">
                                Une lettre courte, une fois par trimestre : retours
                                d'expérience et outils que nous utilisons vraiment.
                            </p>
                            <p class="mb-0">
                                <a href="/contact" class="btn btn-primary">S'inscrire à la lettre</a>
                            </p>
                        </div>
                    </div>
                </div>
            </section>
        </div>
    </xpath>
</template>

<!-- =====================================================================
     Variante 2 — Pied de page compact : une seule ligne.
     ===================================================================== -->
<template id="template_footer_dyo_compact" inherit_id="website.layout"
          name="Agence B2B — Pied de page compact" active="False">
    <xpath expr="//div[@id='footer']" position="replace">
        <div id="footer" class="oe_structure oe_structure_solo text-break o_dyo_footer_compact"
             t-ignore="true" t-if="not no_footer">
            <section class="s_text_block pt32 pb32" data-snippet="s_text_block" data-name="Container">
                <div class="container">
                    <div class="row align-items-center g-3">
                        <div class="col-lg-5">
                            <p class="mb-0">
                                Conception, refonte et exploitation de plateformes métier.
                            </p>
                        </div>
                        <div class="col-lg-7 text-lg-end">
                            <ul class="list-inline mb-0">
                                <li class="list-inline-item"><a href="/services">Services</a></li>
                                <li class="list-inline-item"><a href="/tarifs">Tarifs</a></li>
                                <li class="list-inline-item"><a href="/portfolio">Réalisations</a></li>
                                <li class="list-inline-item"><a href="/a-propos">À propos</a></li>
                                <li class="list-inline-item"><a href="/contact">Contact</a></li>
                            </ul>
                        </div>
                    </div>
                </div>
            </section>
        </div>
    </xpath>
</template>

</odoo>
