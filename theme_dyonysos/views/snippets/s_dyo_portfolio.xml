<?xml version="1.0" encoding="utf-8"?>
<odoo>

<template id="s_dyo_portfolio" name="DYO Portfolio filtrable">
    <section class="s_dyo_portfolio o_cc o_cc2">
        <div class="container">
            <div class="row align-items-end mb-5 g-4">
                <div class="col-lg-6">
                    <span class="o_dyo_eyebrow">Réalisations</span>
                    <h2 class="mb-0">Une sélection de projets récents</h2>
                </div>
                <div class="col-lg-6">
                    <div class="o_dyo_filters" role="group" aria-label="Filtrer les réalisations">
                        <button type="button" class="o_dyo_filter is-active" data-dyo-filter="*">Tout</button>
                        <button type="button" class="o_dyo_filter" data-dyo-filter="plateforme">Plateformes</button>
                        <button type="button" class="o_dyo_filter" data-dyo-filter="donnees">Données</button>
                        <button type="button" class="o_dyo_filter" data-dyo-filter="mobile">Mobile</button>
                    </div>
                </div>
            </div>
            <div class="row g-4 o_dyo_portfolio_grid">
                <div class="col-md-6 col-lg-4 o_dyo_portfolio_item" data-dyo-category="plateforme">
                    <a href="#" class="o_dyo_project">
                        <img src="/theme_dyonysos/static/src/img/project_1.png" loading="lazy"
                             alt="Composition géométrique abstraite illustrant un portail de gestion documentaire"/>
                        <span class="o_dyo_project_tag">Plateforme</span>
                        <span class="o_dyo_project_title">Portail documentaire d'un groupe industriel</span>
                    </a>
                </div>
                <div class="col-md-6 col-lg-4 o_dyo_portfolio_item" data-dyo-category="donnees">
                    <a href="#" class="o_dyo_project">
                        <img src="/theme_dyonysos/static/src/img/project_2.png" loading="lazy"
                             alt="Composition géométrique abstraite illustrant un entrepôt de données"/>
                        <span class="o_dyo_project_tag">Données</span>
                        <span class="o_dyo_project_title">Entrepôt de données pour un réseau de distribution</span>
                    </a>
                </div>
                <div class="col-md-6 col-lg-4 o_dyo_portfolio_item" data-dyo-category="mobile">
                    <a href="#" class="o_dyo_project">
                        <img src="/theme_dyonysos/static/src/img/project_3.png" loading="lazy"
                             alt="Composition géométrique abstraite illustrant une application de terrain"/>
                        <span class="o_dyo_project_tag">Mobile</span>
                        <span class="o_dyo_project_title">Application de relevés pour équipes de terrain</span>
                    </a>
                </div>
                <div class="col-md-6 col-lg-4 o_dyo_portfolio_item" data-dyo-category="plateforme">
                    <a href="#" class="o_dyo_project">
                        <img src="/theme_dyonysos/static/src/img/project_4.png" loading="lazy"
                             alt="Composition géométrique abstraite illustrant un espace client"/>
                        <span class="o_dyo_project_tag">Plateforme</span>
                        <span class="o_dyo_project_title">Espace client d'un cabinet de conseil</span>
                    </a>
                </div>
                <div class="col-md-6 col-lg-4 o_dyo_portfolio_item" data-dyo-category="donnees">
                    <a href="#" class="o_dyo_project">
                        <img src="/theme_dyonysos/static/src/img/project_5.png" loading="lazy"
                             alt="Composition géométrique abstraite illustrant un tableau de bord de pilotage"/>
                        <span class="o_dyo_project_tag">Données</span>
                        <span class="o_dyo_project_title">Tableau de bord de pilotage industriel</span>
                    </a>
                </div>
                <div class="col-md-6 col-lg-4 o_dyo_portfolio_item" data-dyo-category="mobile">
                    <a href="#" class="o_dyo_project">
                        <img src="/theme_dyonysos/static/src/img/project_6.png" loading="lazy"
                             alt="Composition géométrique abstraite illustrant un parcours de prise de rendez-vous"/>
                        <span class="o_dyo_project_tag">Mobile</span>
                        <span class="o_dyo_project_title">Prise de rendez-vous pour un réseau de services</span>
                    </a>
                </div>
            </div>
        </div>
    </section>
</template>

</odoo>
