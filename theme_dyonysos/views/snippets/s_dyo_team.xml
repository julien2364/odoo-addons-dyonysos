                    </div>
                </div>
                <div class="col-6 col-lg-3">
                    <div class="o_dyo_member">
                        <img src="/theme_dyonysos/static/src/img/member_2.png" loading="lazy"
                             alt="Portrait stylisé aux initiales T. L."/>
