                        <p class="o_dyo_member_role mb-3">Ingénieur plateforme</p>
                        <p class="mb-0"><a href="/contact" class="btn btn-link p-0">Écrire à Théo</a></p>
                    </div>
                </div>
                <div class="col-6 col-lg-3">
                    <div class="o_dyo_member">
