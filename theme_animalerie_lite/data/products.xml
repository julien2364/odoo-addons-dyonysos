<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Catalogue de démonstration entièrement fictif. « Trèfle &amp; Museau »
         est une marque inventée pour la démonstration : elle ne correspond à
         aucune entreprise réelle. Les visuels sont générés par programme.
         Ces enregistrements sont supprimables sans effet sur le thème. -->
    <data noupdate="1">

        <record id="categ_chiens" model="product.public.category">
            <field name="name">Chiens</field>
            <field name="sequence">10</field>
        </record>

        <record id="categ_chats" model="product.public.category">
            <field name="name">Chats</field>
            <field name="sequence">20</field>
        </record>

        <record id="categ_petits" model="product.public.category">
            <field name="name">Petits animaux</field>
            <field name="sequence">30</field>
        </record>

        <record id="anim_product_01" model="product.template">
            <field name="name">Gamelle inclinée en grès</field>
            <field name="is_published" eval="True"/>
            <field name="type">consu</field>
            <field name="list_price">24.9</field>
            <field name="description_sale">Grès émaillé, 900 ml, inclinaison à 15° pour limiter les régurgitations. Passe au lave-vaisselle.</field>
            <field name="public_categ_ids" eval="[(6, 0, [ref('categ_chiens')])]"/>
            <field name="image_1920" type="base64" file="theme_animalerie_lite/static/src/img/products/prod_01.png"/>
        </record>

        <record id="anim_product_02" model="product.template">
            <field name="name">Panier matelassé lavable</field>
            <field name="is_published" eval="True"/>
            <field name="type">consu</field>
            <field name="list_price">59.0</field>
            <field name="description_sale">Coussin déhoussable en coton recyclé, lavable à 40°, fond antidérapant. Trois tailles.</field>
            <field name="public_categ_ids" eval="[(6, 0, [ref('categ_chiens')])]"/>
            <field name="image_1920" type="base64" file="theme_animalerie_lite/static/src/img/products/prod_02.png"/>
        </record>

