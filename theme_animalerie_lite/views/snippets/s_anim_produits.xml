<?xml version="1.0" encoding="utf-8"?>
<odoo>

<template id="s_anim_produits" name="Grille de produits">
    <section class="s_anim_produits pt48 pb48 o_cc o_cc2">
        <div class="container">
            <div class="d-flex flex-wrap align-items-end justify-content-between gap-3 mb-4">
                <div>
                    <span class="o_anim_eyebrow">Sélection</span>
                    <h2 class="mb-0">Ce qui part le plus vite</h2>
                </div>
                <a href="/shop" class="btn btn-outline-primary">Toute la boutique</a>
            </div>
            <div class="row g-4">
                <div class="col-lg-3 col-md-6">
                    <article class="o_anim_product_card">
                        <img src="/theme_animalerie_lite/static/src/img/products/prod_01.png" alt=""/>
                        <div class="o_anim_product_body">
                            <span class="o_anim_pill">Chiens</span>
                            <h3 class="h6 mt-2 mb-1">Gamelle inclinée en grès</h3>
                            <p class="small mb-2">Grès émaillé, 900 ml, passe au lave-vaisselle.</p>
                            <p class="o_anim_product_price mb-0">24,90 €</p>
                        </div>
                    </article>
                </div>
                <div class="col-lg-3 col-md-6">
                    <article class="o_anim_product_card">
                        <img src="/theme_animalerie_lite/static/src/img/products/prod_05.png" alt=""/>
                        <div class="o_anim_product_body">
                            <span class="o_anim_pill">Chats</span>
                            <h3 class="h6 mt-2 mb-1">Griffoir vertical en sisal</h3>
                            <p class="small mb-2">Sisal naturel sur socle lesté, 62 cm.</p>
                            <p class="o_anim_product_price mb-0">36,00 €</p>
                        </div>
                    </article>
                </div>
                <div class="col-lg-3 col-md-6">
                    <article class="o_anim_product_card">
                        <img src="/theme_animalerie_lite/static/src/img/products/prod_09.png" alt=""/>
                        <div class="o_anim_product_body">
                            <span class="o_anim_pill">Petits animaux</span>
                            <h3 class="h6 mt-2 mb-1">Cage à barreaux pour rongeur</h3>
                            <p class="small mb-2">80 × 45 × 50 cm, bac profond de 18 cm.</p>
                            <p class="o_anim_product_price mb-0">74,00 €</p>
                        </div>
                    </article>
                </div>
                <div class="col-lg-3 col-md-6">
                    <article class="o_anim_product_card">
                        <img src="/theme_animalerie_lite/static/src/img/products/prod_04.png" alt=""/>
                        <div class="o_anim_product_body">
                            <span class="o_anim_pill o_anim_pill_promo">-10 %</span>
                            <h3 class="h6 mt-2 mb-1">Croquettes sans céréales, poulet</h3>
                            <p class="small mb-2">Sac de 8 kg, 68 % de viande fraîche.</p>
                            <p class="o_anim_product_price mb-0">42,00 €</p>
                        </div>
                    </article>
                </div>
            </div>
        </div>
    </section>
</template>

</odoo>
